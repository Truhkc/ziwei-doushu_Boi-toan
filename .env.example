# 复制为 .env.local 后填入实际值

# ─── AI 推理 ───────────────────────────────────────────────
# /api/interpret（单盘解读）与 /api/heming（合盘分析）用这组配置。
# 只想排盘、看命盘、读古籍的话整段都不用填 —— 排盘在浏览器里完成，不需要任何 Key。
#
# AI_PROVIDER 选一档，然后只填那一档对应的变量：
#   deepseek  | anthropic | openai | mimo | custom
#
# 各档的默认值（base_url / model 可以用对应变量覆盖）：
#   deepseek   DEEPSEEK_API_KEY   base=https://api.deepseek.com/v1   model=deepseek-chat
#   anthropic  ANTHROPIC_API_KEY  base=https://api.anthropic.com     model=claude-sonnet-5-5
#   openai     OPENAI_API_KEY     base=https://api.openai.com/v1     model=gpt-4o
#   mimo       MIMO_API_KEY       base/model 必填
#   custom     AI_API_KEY         base/model 必填

AI_PROVIDER=deepseek
DEEPSEEK_API_KEY=your-deepseek-api-key
# DEEPSEEK_BASE_URL=https://api.deepseek.com/v1
# DEEPSEEK_MODEL=deepseek-chat

# ─── 或用 Anthropic ───
# 注意：装过 Claude Code 的机器通常已经导出了 ANTHROPIC_BASE_URL，
# 而 .env.local 覆盖不了进程里已有的变量 —— 先用
#   env | grep -i '^ANTHROPIC'
# 检查一下；撞名了就改走 AI_PROVIDER=custom。
# AI_PROVIDER=anthropic
# ANTHROPIC_API_KEY=your-api-key
# ANTHROPIC_MODEL=claude-sonnet-5-5

# ─── 或用 OpenAI ───
# AI_PROVIDER=openai
# OPENAI_API_KEY=your-api-key
# OPENAI_MODEL=gpt-4o

# ─── 或用其他 OpenAI 兼容模型 ───
# AI_PROVIDER=mimo
# MIMO_API_KEY=your-api-key
# MIMO_BASE_URL=https://your-provider/v1
# MIMO_MODEL=model-name

# ─── 或用模型跑在本机（不需要任何 API Key）───
# Ollama：先 `ollama serve`，再 `ollama pull qwen2.5`，AI_MODEL 填你拉下来的名字
# AI_PROVIDER=ollama
# AI_MODEL=qwen2.5
# AI_BASE_URL=http://localhost:11434/v1   # 改过端口才需要填

# LM Studio：在界面里打开 Local Server，AI_MODEL 填已加载的模型名
# AI_PROVIDER=lmstudio
# AI_MODEL=local-model

# ─── 或任意 OpenAI 兼容端点 ───
# AI_PROVIDER=custom
# AI_API_KEY=your-api-key
# AI_BASE_URL=https://your-provider/v1
# AI_MODEL=model-name

# ─── 限流（进程内计数）───────────────────────────────────────
# 每个 IP 在 AI_RATE_WINDOW_SEC 秒内最多调用 AI_RATE_LIMIT 次。
# 注意：计数存在单个 Node 进程的内存里 —— serverless 多实例下每个实例一份，
# 只能挡连点，挡不住有心刷量。要真防刷请改成 Redis 实现或上游 WAF。
# AI_RATE_LIMIT=20
# AI_RATE_WINDOW_SEC=300

# ─── 站点 ───────────────────────────────────────────────────
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# ─── 搜索引擎站点验证（可选）─────────────────────────────────
# NEXT_PUBLIC_GOOGLE_VERIFICATION=
# NEXT_PUBLIC_BING_VERIFICATION=
# NEXT_PUBLIC_BAIDU_VERIFICATION=
# NEXT_PUBLIC_360_VERIFICATION=
